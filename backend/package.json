{
  "name": "ordenix-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for Ordenix",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "db:init": "ts-node scripts/inicializar-bd.script.ts",
    "seed:admin": "ts-node scripts/sembrar-admin.script.ts",
    "seed:repartidor": "ts-node scripts/sembrar-repartidor.script.ts",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
